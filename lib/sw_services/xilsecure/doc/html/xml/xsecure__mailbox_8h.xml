      <memberdef kind="function" id="group__xsecure__mailbox__apis_1ga3f3e211a21446c799c1099f36074ce2f" prot="public" static="yes" const="no" explicit="no" inline="yes" virt="non-virtual">
        <type>int</type>
        <definition>static int XSecure_SetSlrIndex</definition>
        <argsstring>(XSecure_ClientInstance *InstancePtr, u32 SlrIndex)</argsstring>
        <name>XSecure_SetSlrIndex</name>
        <param>
          <type>XSecure_ClientInstance *</type>
          <declname>InstancePtr</declname>
        </param>
        <param>
          <type>u32</type>
          <declname>SlrIndex</declname>
        </param>
        <briefdescription>
<para>This function sets slr index in the Secure client instance. </para>        </briefdescription>
        <detaileddescription>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>InstancePtr</parametername>
</parameternamelist>
<parameterdescription>
<para>Pointer to XSecure_ClientInstance </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>SlrIndex</parametername>
</parameternamelist>
<parameterdescription>
<para>Slr index to be set in instance</para></parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para><itemizedlist>
<listitem><para>XST_SUCCESS - On valid input SlrIndex.</para></listitem><listitem><para>XST_FAILURE - On invalid SlrIndex.</para></listitem></itemizedlist>
</para></simplesect>
<simplesect kind="note"><para>This function is applicable to only Versal </para></simplesect>
</para>        </detaileddescription>
        <inbodydescription>
<para>Validate SlrIndex and assign it to instance pointer </para>        </inbodydescription>
        <location file="/proj/xhdsswstaff1/bhawanas/patch_integration/auto_jobs/esw_github_doxy/git/2026.2/embeddedsw/lib/sw_services/xilsecure/src/client/core/mailbox/xsecure_mailbox.h" line="150" column="1" bodyfile="/proj/xhdsswstaff1/bhawanas/patch_integration/auto_jobs/esw_github_doxy/git/2026.2/embeddedsw/lib/sw_services/xilsecure/src/client/core/mailbox/xsecure_mailbox.h" bodystart="150" bodyend="161"/>
      </memberdef>
      <memberdef kind="function" id="group__xsecure__mailbox__apis_1ga172d3381387b4ba9fdec420f63e64b17" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>int</type>
        <definition>int XSecure_ProcessMailbox</definition>
        <argsstring>(XMailbox *MailboxPtr, u32 *MsgPtr, u32 MsgLen, u32 *Response)</argsstring>
        <name>XSecure_ProcessMailbox</name>
        <param>
          <type>XMailbox *</type>
          <declname>MailboxPtr</declname>
        </param>
        <param>
          <type>u32 *</type>
          <declname>MsgPtr</declname>
        </param>
        <param>
          <type>u32</type>
          <declname>MsgLen</declname>
        </param>
        <param>
          <type>u32 *</type>
          <declname>Response</declname>
        </param>
        <briefdescription>
<para>This function sends IPI request to the target module and gets the response from it. </para>        </briefdescription>
        <detaileddescription>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>MailboxPtr</parametername>
</parameternamelist>
<parameterdescription>
<para>Pointer to XMailbox </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>MsgPtr</parametername>
</parameternamelist>
<parameterdescription>
<para>Pointer to the payload message </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>MsgLen</parametername>
</parameternamelist>
<parameterdescription>
<para>Length of the message </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>Response</parametername>
</parameternamelist>
<parameterdescription>
<para>Pointer to a buffer of RESPONSE_ARG_CNT words that receives the full IPI response payload. May be NULL when only the status word is needed.</para></parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para><itemizedlist>
<listitem><para>XST_SUCCESS If the IPI send and receive is successful</para></listitem><listitem><para>XST_INVALID_PARAM On invalid input parameter</para></listitem><listitem><para>XST_FAILURE If there is a failure</para></listitem><listitem><para>Response status word received from the server</para></listitem></itemizedlist>
</para></simplesect>
<simplesect kind="note"><para>Payload consists of API ID and call arguments to be written in the IPI buffer. Response[0] carries the server status word; subsequent words carry the command-specific payload. When Response is NULL a local buffer is used so status-only callers need not allocate one. </para></simplesect>
</para>        </detaileddescription>
        <inbodydescription>
<para><itemizedlist>
<listitem><para>Status-only callers pass NULL; fall back to a local response buffer.</para></listitem><listitem><para>Return XST_INVALID_PARAM if NULL pointer and MsgLen range validation failed</para></listitem><listitem><para>Send CDO to PLM through IPI. Return XST_FAILURE if sending data failed</para></listitem><listitem><para>Wait for IPI response from PLM with a timeout. If the timeout exceeds then error is returned otherwise it returns the status of the IPI response</para></listitem></itemizedlist>
</para>        </inbodydescription>
