      <sectiondef kind="func">
      <memberdef kind="function" id="group__xsecure__kat__server__apis_1ga693f088bbeaa2be1dd7a084c2bee6351" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>int</type>
        <definition>int XSecure_KatIpiHandler</definition>
        <argsstring>(XPlmi_Cmd *Cmd)</argsstring>
        <name>XSecure_KatIpiHandler</name>
        <param>
          <type>XPlmi_Cmd *</type>
          <declname>Cmd</declname>
        </param>
        <briefdescription>
<para>This function calls respective IPI handler based on the API_ID and updates the RTCA KAT mask after the KAT runs. </para>        </briefdescription>
        <detaileddescription>
<para>Event-handling failures do not change the previous KAT bit.</para><para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>Cmd</parametername>
</parameternamelist>
<parameterdescription>
<para>is a pointer to the command structure</para></parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para><itemizedlist>
<listitem><para>XST_SUCCESS - If the handler execution is successful</para></listitem><listitem><para>XST_INVALID_PARAM - If Cmd is NULL or invalid API ID is received.</para></listitem><listitem><para>XST_FAILURE - If there is a failure </para></listitem></itemizedlist>
</para></simplesect>
</para>        </detaileddescription>
        <inbodydescription>
<para><itemizedlist>
<listitem><para>Call the respective API handler according to API ID</para></listitem><listitem><para>XSecure_AesDecryptKat</para></listitem><listitem><para>XSecure_AesDecryptCmKat</para></listitem><listitem><para>XSecure_AesEncryptKat</para></listitem><listitem><para>XSecure_RsaPublicEncryptKat</para></listitem><listitem><para>XSecure_RsaPrivateDecryptKat</para></listitem><listitem><para>XSecure_EllipticVerifySignKat</para></listitem><listitem><para>XSecure_EllipticSignGenerateKat</para></listitem><listitem><para>XSecure_Sha3Kat</para></listitem><listitem><para>SHA IPI event handling </para></listitem></itemizedlist>
</para>        </inbodydescription>
