      <memberdef kind="variable" id="struct_x_asu___key_manager_params_1ab434c6fe4301663ed0221d47bb2cd0e7" prot="public" static="no" mutable="no">
        <type>u32</type>
        <definition>u32 XAsu_KeyManagerParams::KeyObjectLen</definition>
        <argsstring></argsstring>
        <name>KeyObjectLen</name>
        <briefdescription>
<para>Byte length of the buffer at KeyObjectAddr. </para>        </briefdescription>
        <detaileddescription>
<para>For Store Key API: mandatory; size of the input key buffer. Must be at least KeyMetadata.Length for plain keys of types whose on-wire object equals Length, at least sizeof(XAsu_RsaKeyPairObject) / sizeof(XAsu_RsaPubKeyComp) for RSA private/public store, at least twice the curve length for ECC public store, or at least WrappedInputLen when the key type is wrapped. For Generate Key APIs with export to client memory: mandatory; size of the output buffer. Must be at least KeyMetadata.Length, at least XASU_KM_RSA_EXPORT_LEN(KeyMetadata.Length) for RSA key-pair export, at least sizeof(XAsu_EccKeyPairObject) for ECC key-pair export, or the combined public and private key lengths for PQC key-pair export. Not used when the generated key is stored only in the vault (KeyObjectAddr is zero). </para>        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
        <location file="/proj/xhdsswstaff1/bhawanas/patch_integration/auto_jobs/esw_github_doxy/git/master/embeddedsw/lib/sw_services/xilasu/src/common/xasu_keymanagerinfo.h" line="332" column="1" bodyfile="/proj/xhdsswstaff1/bhawanas/patch_integration/auto_jobs/esw_github_doxy/git/master/embeddedsw/lib/sw_services/xilasu/src/common/xasu_keymanagerinfo.h" bodystart="332" bodyend="-1"/>
