        </param>
        <param>
          <type>u32</type>
          <declname>SecondLen</declname>
        </param>
        <briefdescription>
<para>This function checks whether two non-empty address ranges overlap or either range wraps. </para>        </briefdescription>
        <detaileddescription>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>FirstAddr</parametername>
</parameternamelist>
<parameterdescription>
<para>Start address of the first range. </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>FirstLen</parametername>
</parameternamelist>
<parameterdescription>
<para>Length of the first range. </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>SecondAddr</parametername>
</parameternamelist>
<parameterdescription>
<para>Start address of the second range. </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>SecondLen</parametername>
</parameternamelist>
<parameterdescription>
<para>Length of the second range.</para></parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para><itemizedlist>
<listitem><para>XASU_TRUE, if either range wraps or the ranges overlap.</para></listitem><listitem><para>XASU_FALSE, if either range is empty or the ranges are representable and disjoint. </para></listitem></itemizedlist>
</para></simplesect>
</para>        </detaileddescription>
