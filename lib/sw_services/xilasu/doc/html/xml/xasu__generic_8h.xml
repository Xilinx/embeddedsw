        <argsstring>(u64 FirstAddr, u32 FirstLen, u64 SecondAddr, u32 SecondLen)</argsstring>
        <name>XAsu_IsRangeOverlap</name>
        <param>
          <type>u64</type>
          <declname>FirstAddr</declname>
        </param>
        <param>
          <type>u32</type>
          <declname>FirstLen</declname>
        </param>
        <param>
