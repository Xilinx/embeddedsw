    <title>SLH-DSA Common APIs</title>
      <sectiondef kind="func">
      <memberdef kind="function" id="group__xasu__slhdsa__common__apis_1ga05a234d24f281e39e9f241da6a9a00bc" prot="public" static="yes" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>s32</type>
        <definition>static s32 XAsu_SlhdsaValidateCtxLen</definition>
        <argsstring>(u32 CtxLen)</argsstring>
        <name>XAsu_SlhdsaValidateCtxLen</name>
        <param>
          <type>u32</type>
          <declname>CtxLen</declname>
        </param>
        <briefdescription>
<para>This function validates the FIPS 205 context length field. </para>        </briefdescription>
        <detaileddescription>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>CtxLen</parametername>
</parameternamelist>
<parameterdescription>
<para>Context length: 0..XASU_SLHDSA_MAX_CTX_LEN (FIPS context).</para></parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para><itemizedlist>
<listitem><para>XST_SUCCESS, if CtxLen is valid.</para></listitem><listitem><para>XST_INVALID_PARAM, if CtxLen exceeds XASU_SLHDSA_MAX_CTX_LEN. </para></listitem></itemizedlist>
</para></simplesect>
</para>        </detaileddescription>
        <inbodydescription>
<para>FIPS 205 encodes the context length in a single byte, so any value above XASU_SLHDSA_MAX_CTX_LEN cannot be represented in the signed message prefix. CtxLen zero is valid and selects the empty context.</para>        </inbodydescription>
        <location file="/proj/xhdsswstaff1/bhawanas/patch_integration/auto_jobs/esw_github_doxy/git/2026.2/embeddedsw/lib/sw_services/xilasu/src/common/xasu_slhdsa_common.c" line="40" column="1" bodyfile="/proj/xhdsswstaff1/bhawanas/patch_integration/auto_jobs/esw_github_doxy/git/2026.2/embeddedsw/lib/sw_services/xilasu/src/common/xasu_slhdsa_common.c" bodystart="488" bodyend="506"/>
      </memberdef>
      <memberdef kind="function" id="group__xasu__slhdsa__common__apis_1ga74d0db64a0994cec9f2372b1d20f80b4" prot="public" static="yes" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>u8</type>
        <definition>static u8 XAsu_SlhdsaGetPreHashHashId</definition>
        <argsstring>(u8 ParamSet)</argsstring>
        <name>XAsu_SlhdsaGetPreHashHashId</name>
        <param>
          <type>u8</type>
          <declname>ParamSet</declname>
        </param>
        <briefdescription>
<para>This function returns the required pre-hash HashId for a parameter set. </para>        </briefdescription>
        <detaileddescription>
<para>FIPS 205 footnote 18: PH(M) must be at least 2n bytes. 128s sets (n = 16) use SHA-256; 256s sets (n = 32) use SHA-512.</para><para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>ParamSet</parametername>
</parameternamelist>
<parameterdescription>
<para>SLH-DSA parameter set selector (XASU_SLHDSA_PARAM_*).</para></parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>XASU_SLHDSA_HASHID_SHA256 or XASU_SLHDSA_HASHID_SHA512, or XASU_SLHDSA_HASHID_INVALID if ParamSet is unsupported. </para></simplesect>
</para>        </detaileddescription>
        <inbodydescription>
<para>256s sets require SHA-512 (n = 32); 128s sets require SHA-256 (n = 16). An unsupported ParamSet returns XASU_SLHDSA_HASHID_INVALID.</para>        </inbodydescription>
        <location file="/proj/xhdsswstaff1/bhawanas/patch_integration/auto_jobs/esw_github_doxy/git/2026.2/embeddedsw/lib/sw_services/xilasu/src/common/xasu_slhdsa_common.c" line="41" column="1" bodyfile="/proj/xhdsswstaff1/bhawanas/patch_integration/auto_jobs/esw_github_doxy/git/2026.2/embeddedsw/lib/sw_services/xilasu/src/common/xasu_slhdsa_common.c" bodystart="222" bodyend="248"/>
      </memberdef>
      <memberdef kind="function" id="group__xasu__slhdsa__common__apis_1ga55c1b259b29ef6591f696dac8a6d3b2e" prot="public" static="yes" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>s32</type>
        <definition>static s32 XAsu_SlhdsaValidateParamSet</definition>
        <argsstring>(u8 ParamSet)</argsstring>
        <name>XAsu_SlhdsaValidateParamSet</name>
        <param>
          <type>u8</type>
          <declname>ParamSet</declname>
        </param>
        <briefdescription>
<para>This function validates the SLH-DSA parameter set selector. </para>        </briefdescription>
        <detaileddescription>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>ParamSet</parametername>
</parameternamelist>
<parameterdescription>
<para>SLH-DSA parameter set selector (XASU_SLHDSA_PARAM_*).</para></parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para><itemizedlist>
<listitem><para>XST_SUCCESS, if ParamSet is a supported value (0..3).</para></listitem><listitem><para>XST_INVALID_PARAM, if ParamSet is out of range. </para></listitem></itemizedlist>
</para></simplesect>
</para>        </detaileddescription>
        <inbodydescription>
<para>The supported parameter sets are numbered contiguously with XASU_SLHDSA_PARAM_SHA2_128S as the highest value, so a single upper-bound check rejects every unsupported selector.</para>        </inbodydescription>
        <location file="/proj/xhdsswstaff1/bhawanas/patch_integration/auto_jobs/esw_github_doxy/git/2026.2/embeddedsw/lib/sw_services/xilasu/src/common/xasu_slhdsa_common.c" line="42" column="1" bodyfile="/proj/xhdsswstaff1/bhawanas/patch_integration/auto_jobs/esw_github_doxy/git/2026.2/embeddedsw/lib/sw_services/xilasu/src/common/xasu_slhdsa_common.c" bodystart="260" bodyend="277"/>
      </memberdef>
      <memberdef kind="function" id="group__xasu__slhdsa__common__apis_1ga8a3fb0934ab01f95d342cdc3f3c1044e" prot="public" static="yes" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>s32</type>
        <definition>static s32 XAsu_SlhdsaValidateCtxAddr</definition>
        <argsstring>(u64 CtxAddr, u32 CtxLen)</argsstring>
        <name>XAsu_SlhdsaValidateCtxAddr</name>
        <param>
          <type>u64</type>
          <declname>CtxAddr</declname>
        </param>
        <param>
          <type>u32</type>
          <declname>CtxLen</declname>
        </param>
        <briefdescription>
<para>This function validates that CtxAddr is provided when a non-empty context is specified. </para>        </briefdescription>
        <detaileddescription>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>CtxAddr</parametername>
</parameternamelist>
<parameterdescription>
<para>DMA address of context bytes (required when CtxLen is 1..255). </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>CtxLen</parametername>
</parameternamelist>
<parameterdescription>
<para>Context length field from sign or verify parameters.</para></parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para><itemizedlist>
<listitem><para>XST_SUCCESS, if CtxAddr is valid for the given CtxLen.</para></listitem><listitem><para>XST_INVALID_PARAM, if CtxLen is 1..255 and CtxAddr is zero. </para></listitem></itemizedlist>
</para></simplesect>
</para>        </detaileddescription>
        <inbodydescription>
<para>A non-zero context length promises context bytes to hash, so the address must be present. The reverse case is allowed: a non-zero address with CtxLen zero is simply ignored and treated as the empty context.</para>        </inbodydescription>
        <location file="/proj/xhdsswstaff1/bhawanas/patch_integration/auto_jobs/esw_github_doxy/git/2026.2/embeddedsw/lib/sw_services/xilasu/src/common/xasu_slhdsa_common.c" line="43" column="1" bodyfile="/proj/xhdsswstaff1/bhawanas/patch_integration/auto_jobs/esw_github_doxy/git/2026.2/embeddedsw/lib/sw_services/xilasu/src/common/xasu_slhdsa_common.c" bodystart="520" bodyend="538"/>
      </memberdef>
      <memberdef kind="function" id="group__xasu__slhdsa__common__apis_1ga259a1aa48fda62fef35606f43354d1af" prot="public" static="yes" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>s32</type>
        <definition>static s32 XAsu_SlhdsaValidatePreHashFields</definition>
        <argsstring>(u8 ParamSet, u8 PreHashMode, u8 HashId, u32 MsgLen)</argsstring>
        <name>XAsu_SlhdsaValidatePreHashFields</name>
        <param>
          <type>u8</type>
          <declname>ParamSet</declname>
        </param>
        <param>
          <type>u8</type>
          <declname>PreHashMode</declname>
        </param>
        <param>
          <type>u8</type>
          <declname>HashId</declname>
        </param>
        <param>
          <type>u32</type>
          <declname>MsgLen</declname>
        </param>
        <briefdescription>
<para>This function validates HashSLH-DSA pre-hash fields on sign/verify parameters. </para>        </briefdescription>
        <detaileddescription>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>ParamSet</parametername>
</parameternamelist>
<parameterdescription>
<para>Parameter set selector (determines required HashId). </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>PreHashMode</parametername>
</parameternamelist>
<parameterdescription>
<para>XASU_SLHDSA_MSG_PURE or XASU_SLHDSA_MSG_PREHASH. </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>HashId</parametername>
</parameternamelist>
<parameterdescription>
<para>Pre-hash function identifier. </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>MsgLen</parametername>
</parameternamelist>
<parameterdescription>
<para>Message or PH(M) digest length in bytes.</para></parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para><itemizedlist>
<listitem><para>XST_SUCCESS, if pre-hash fields are valid.</para></listitem><listitem><para>XST_INVALID_PARAM, otherwise. </para></listitem></itemizedlist>
</para></simplesect>
</para>        </detaileddescription>
        <inbodydescription>
<para>Accept only the two defined message modes.</para><para>Pure SLH-DSA hashes the message itself, so HashId is unused and MsgLen is already bounded by the caller. Nothing further to check.</para><para>HashSLH-DSA fixes the pre-hash function per parameter set, so that PH(M) is at least 2n bytes (FIPS 205 footnote 18). A caller supplied HashId that disagrees is rejected instead of being overridden.</para><para>A zero digest length means HashId is not a supported pre-hash function.</para><para>In pre-hash mode the caller passes PH(M) rather than the message, so MsgLen must be exactly the digest length of the selected pre-hash function.</para>        </inbodydescription>
        <location file="/proj/xhdsswstaff1/bhawanas/patch_integration/auto_jobs/esw_github_doxy/git/2026.2/embeddedsw/lib/sw_services/xilasu/src/common/xasu_slhdsa_common.c" line="44" column="1" bodyfile="/proj/xhdsswstaff1/bhawanas/patch_integration/auto_jobs/esw_github_doxy/git/2026.2/embeddedsw/lib/sw_services/xilasu/src/common/xasu_slhdsa_common.c" bodystart="584" bodyend="636"/>
      </memberdef>
      <memberdef kind="function" id="group__xasu__slhdsa__common__apis_1gaa15afafb2427dc6d31ae1b913b077206" prot="public" static="yes" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>s32</type>
        <definition>static s32 XAsu_SlhdsaValidateSignMode</definition>
        <argsstring>(u8 SignMode)</argsstring>
        <name>XAsu_SlhdsaValidateSignMode</name>
        <param>
          <type>u8</type>
          <declname>SignMode</declname>
        </param>
        <briefdescription>
<para>This function validates the SLH-DSA sign mode field. </para>        </briefdescription>
        <detaileddescription>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>SignMode</parametername>
</parameternamelist>
<parameterdescription>
<para>XASU_SLHDSA_SIGN_MODE_HEDGED or XASU_SLHDSA_SIGN_MODE_DETERMINISTIC.</para></parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para><itemizedlist>
<listitem><para>XST_SUCCESS, if SignMode is valid.</para></listitem><listitem><para>XST_INVALID_PARAM, otherwise. </para></listitem></itemizedlist>
</para></simplesect>
</para>        </detaileddescription>
        <inbodydescription>
<para>Accept only the two defined modes. Any other value is rejected rather than being silently treated as hedged, so a corrupted field cannot quietly change how the signature randomizer is derived.</para>        </inbodydescription>
        <location file="/proj/xhdsswstaff1/bhawanas/patch_integration/auto_jobs/esw_github_doxy/git/2026.2/embeddedsw/lib/sw_services/xilasu/src/common/xasu_slhdsa_common.c" line="46" column="1" bodyfile="/proj/xhdsswstaff1/bhawanas/patch_integration/auto_jobs/esw_github_doxy/git/2026.2/embeddedsw/lib/sw_services/xilasu/src/common/xasu_slhdsa_common.c" bodystart="550" bodyend="569"/>
      </memberdef>
