      <memberdef kind="function" id="group__xiltimer__api_1ga4381a7c988933521223d057ac235cc91" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>void</type>
        <definition>void XTimer_SetIntervalHz</definition>
        <argsstring>(u32 FreqHz)</argsstring>
        <name>XTimer_SetIntervalHz</name>
        <param>
          <type>u32</type>
          <declname>FreqHz</declname>
        </param>
        <briefdescription>
<para>This API configures the tick interval from a frequency in Hz, instead of whole milliseconds. </para>        </briefdescription>
        <detaileddescription>
<para>Sets the tick interval from a frequency in Hz.</para><para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername direction="in">FreqHz</parametername>
</parameternamelist>
<parameterdescription>
<para>Required tick frequency in Hz</para></parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="note"><para>If the selected tick timer does not implement XTimer_TickIntervalHz, this API uses Delay = 1000 / FreqHz with integer truncation, so the programmed rate matches FreqHz only when 1000 is an exact multiple of FreqHz. </para></simplesect>
</para>        </detaileddescription>
