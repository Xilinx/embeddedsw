      <memberdef kind="define" id="xilflash__cfi_8h_1a12bd0c89aecceb6ce7e6449d0a76137a" prot="public" static="no">
        <name>XFL_CFI_POSITION_PTR</name>
        <param><defname>Ptr</defname></param>
        <param><defname>BaseAddr</defname></param>
        <param><defname>Interleave</defname></param>
        <param><defname>ByteAddr</defname></param>
        <initializer>(								  	\
			Ptr = (void*)((u32)BaseAddr + ((u32)Interleave *	  	\
					(u32)ByteAddr))	  	\
	)</initializer>
        <briefdescription>
<para>Moves the CFI data pointer to the address of a CFI byte offset. </para>        </briefdescription>
        <detaileddescription>
<para>Moves the CFI data pointer to a physical address that corresponds to a specific CFI byte offset.</para><para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername direction="out">Ptr</parametername>
</parameternamelist>
<parameterdescription>
<para>Pointer to modify. Can be of any type. </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">BaseAddr</parametername>
</parameternamelist>
<parameterdescription>
<para>Base address of flash part. </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">Interleave</parametername>
</parameternamelist>
<parameterdescription>
<para>Byte interleaving (based on part layout). </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">ByteAddr</parametername>
</parameternamelist>
<parameterdescription>
<para>Byte offset within CFI data to read.</para></parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>The Ptr argument is set to point at the CFI byte specified by the ByteAddr parameter.</para></simplesect>
<simplesect kind="note"><para>C-style signature: void *XFL_CFI_POSITION_PTR(void *Ptr, u32 BaseAddr, u8 Interleave, u32 ByteAddr) </para></simplesect>
</para>        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
