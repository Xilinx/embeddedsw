      <memberdef kind="function" id="group__xnvm__client__apis_1ga537288ea737e98beb3a73a185fc31bbd" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>int</type>
        <definition>int XNvm_GetClientLibVersion</definition>
        <argsstring>(u32 *Version)</argsstring>
        <name>XNvm_GetClientLibVersion</name>
        <param>
          <type>u32 *</type>
          <declname>Version</declname>
        </param>
        <briefdescription>
<para>This function returns the XilNvm library version that the client is built with. </para>        </briefdescription>
        <detaileddescription>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>Version</parametername>
</parameternamelist>
<parameterdescription>
<para>Pointer to hold the 32-bit library version, where the upper 16 bits hold the major version and the lower 16 bits hold the minor version</para></parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para><itemizedlist>
<listitem><para>XST_SUCCESS If the library version is read successfully</para></listitem><listitem><para>XST_INVALID_PARAM If Version is NULL </para></listitem></itemizedlist>
</para></simplesect>
</para>        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
        <location file="/proj/xhdsswstaff1/bhawanas/patch_integration/auto_jobs/esw_github_doxy/git/master/embeddedsw/lib/sw_services/xilnvm/src/versal_gen/common/client/xnvm_client.c" line="59" column="1" bodyfile="/proj/xhdsswstaff1/bhawanas/patch_integration/auto_jobs/esw_github_doxy/git/master/embeddedsw/lib/sw_services/xilnvm/src/versal_gen/common/client/xnvm_client.c" bodystart="59" bodyend="73"/>
