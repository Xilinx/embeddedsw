<parametername>:</parametername>
</parameternamelist>
<parameterdescription>
<para>Requested end column</para></parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>XST_SUCCESS if within bounds or unconstrained, XST_INVALID_PARAM otherwise</para></simplesect>
