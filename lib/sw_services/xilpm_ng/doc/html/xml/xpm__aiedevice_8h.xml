        <type>XStatus</type>
        <definition>XStatus XPmAieDevice_Init</definition>
        <argsstring>(XPm_AieDevice *AieDevice, u32 NodeId, u32 BaseAddress, XPm_Power *Power, XPm_ClockNode *Clock, XPm_ResetNode *Reset, u16 StartCol, u16 EndCol, u8 IsPartitioned)</argsstring>
        <name>XPmAieDevice_Init</name>
        <param>
          <type>XPm_AieDevice *</type>
          <declname>AieDevice</declname>
        </param>
        <param>
          <type>u32</type>
          <declname>NodeId</declname>
        </param>
        <param>
          <type>u32</type>
          <declname>BaseAddress</declname>
        </param>
        <param>
          <type>XPm_Power *</type>
          <declname>Power</declname>
        </param>
        <param>
          <type><ref refid="struct_x_pm___clock_node" kindref="compound">XPm_ClockNode</ref> *</type>
          <declname>Clock</declname>
        </param>
        <param>
          <type><ref refid="struct_x_pm___reset_node" kindref="compound">XPm_ResetNode</ref> *</type>
          <declname>Reset</declname>
        </param>
        <param>
          <type>u16</type>
          <declname>StartCol</declname>
        </param>
        <param>
          <type>u16</type>
          <declname>EndCol</declname>
        </param>
        <param>
          <type>u8</type>
          <declname>IsPartitioned</declname>
        </param>
        <briefdescription>
<para>Initialize an AIE device and its partition bounds. </para>        </briefdescription>
        <detaileddescription>
<para>Initializes the embedded generic device with its power, clock, and reset dependencies. On success, clears the AIE parent link and records the column range and partition flag supplied by the topology.</para><para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>AieDevice</parametername>
</parameternamelist>
<parameterdescription>
<para>Pointer to the AIE device object to initialize. </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>NodeId</parametername>
</parameternamelist>
<parameterdescription>
<para>Node ID assigned to the AIE device. </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>BaseAddress</parametername>
</parameternamelist>
<parameterdescription>
<para>Device register base address supplied by the topology. </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>Power</parametername>
</parameternamelist>
<parameterdescription>
<para>Pointer to the device&apos;s power dependency. </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>Clock</parametername>
</parameternamelist>
<parameterdescription>
<para>Pointer to the device&apos;s clock dependency. </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>Reset</parametername>
</parameternamelist>
<parameterdescription>
<para>Pointer to the device&apos;s reset dependency. </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>StartCol</parametername>
</parameternamelist>
<parameterdescription>
<para>Inclusive first column of the partition, or 0 if unconstrained. </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>EndCol</parametername>
</parameternamelist>
<parameterdescription>
<para>Inclusive last column of the partition, or 0 if unconstrained. </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>IsPartitioned</parametername>
</parameternamelist>
<parameterdescription>
<para>Nonzero when the supplied column bounds constrain the device, and zero when the device is unconstrained.</para></parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>XST_SUCCESS when the generic device and partition data are initialized, or the error returned by XPmDevice_Init(). Partition fields are not updated when generic device initialization fails. </para></simplesect>
</para>        </detaileddescription>
