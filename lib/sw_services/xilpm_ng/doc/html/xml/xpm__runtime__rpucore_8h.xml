        <detaileddescription>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>DeviceId</parametername>
</parameternamelist>
<parameterdescription>
<para>Node ID of the target RPU core device </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>BootAddr</parametername>
</parameternamelist>
<parameterdescription>
<para>Boot vector address; 0 selects TCM boot</para></parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>XST_SUCCESS on success; XST_INVALID_PARAM if DeviceId is invalid or BootAddr is misaligned; XST_FAILURE on register-write glitch detection. </para></simplesect>
</para>        </detaileddescription>
