        <definition>XStatus XPmCore_SetCoreIdleSupport</definition>
        <argsstring>(XPm_Core *Core, const u32 Value)</argsstring>
        <name>XPmCore_SetCoreIdleSupport</name>
        <param>
          <type><ref refid="struct_x_pm___core" kindref="compound">XPm_Core</ref> *</type>
          <declname>Core</declname>
        </param>
        <param>
          <type>const u32</type>
          <declname>Value</declname>
        </param>
        <briefdescription>
<para>Store whether the given core supports idle notifications. </para>        </briefdescription>
        <detaileddescription>
<para>A runtime entry is allocated and added when the core has not been seen before; otherwise the existing entry is updated.</para><para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>Core</parametername>
</parameternamelist>
<parameterdescription>
<para>Pointer to the core whose idle support is updated </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>Value</parametername>
</parameternamelist>
<parameterdescription>
<para>Idle-support value whose low 8 bits are stored</para></parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>XST_SUCCESS on success, XST_INVALID_PARAM for a NULL core, or XST_BUFFER_TOO_SMALL if runtime storage cannot be allocated </para></simplesect>
</para>        </detaileddescription>
