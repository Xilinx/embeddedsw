      <memberdef kind="function" id="xpm__runtime__core_8h_1a9dd94beac0fb3ccfc5049fde44a49a5d" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>XStatus</type>
        <definition>XStatus ResetAPUGic</definition>
        <argsstring>(const u32 DeviceId)</argsstring>
        <name>ResetAPUGic</name>
        <param>
          <type>const u32</type>
          <declname>DeviceId</declname>
        </param>
        <briefdescription>
<para>Pulses the APU GIC reset when all APU cores are powered off and the FPD power domain is on. </para>        </briefdescription>
        <detaileddescription>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>DeviceId</parametername>
</parameternamelist>
<parameterdescription>
<para>Device ID of the APU core being processed</para></parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>XST_SUCCESS on success, error code otherwise</para></simplesect>
Pulses the APU GIC reset when all APU cores are powered off and the FPD power domain is on.</para><para>The APU GIC is shared by all APU clusters, so it is only reset while FPD is on and no APU core device is up.</para><para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>DeviceId</parametername>
</parameternamelist>
<parameterdescription>
<para>Any APU core device ID; only its type is checked, any other type leaves the GIC untouched</para></parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>XST_SUCCESS if the GIC was reset or did not need a reset, or the error of the reset otherwise </para></simplesect>
</para>        </detaileddescription>
