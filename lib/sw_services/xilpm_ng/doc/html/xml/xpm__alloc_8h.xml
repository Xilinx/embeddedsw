      </memberdef>
      <memberdef kind="function" id="xpm__alloc_8h_1a3ba40d3dabe1c8aca09e36c62d8ef412" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>void *</type>
        <definition>void* XPm_AllocPool</definition>
        <argsstring>(u32 SizeInBytes, XPm_AllocablePool_t *PoolMem)</argsstring>
        <name>XPm_AllocPool</name>
        <param>
          <type>u32</type>
          <declname>SizeInBytes</declname>
        </param>
        <param>
          <type>XPm_AllocablePool_t *</type>
          <declname>PoolMem</declname>
        </param>
        <briefdescription>
<para>Allocate zero-initialized storage from a monotonic memory pool. </para>        </briefdescription>
        <detaileddescription>
<para>Rounds <computeroutput>SizeInBytes</computeroutput> up to a four-byte boundary, advances the pool&apos;s free pointer by the rounded size, and securely zeroes the allocated region. The pool has no corresponding free operation, and a zeroization failure does not roll back the free pointer.</para><para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>SizeInBytes</parametername>
</parameternamelist>
<parameterdescription>
<para>Number of bytes requested. </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>PoolMem</parametername>
</parameternamelist>
<parameterdescription>
<para>Pool descriptor whose free pointer is advanced on success.</para></parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>Pointer to the allocated region if allocation reaches the zeroization step, including when secure zeroization fails (in which case the returned memory may not be zeroed); NULL if the pool has no bytes left or the rounded request exceeds the available space. </para></simplesect>
</para>        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
        <location file="/proj/xhdsswstaff1/bhawanas/patch_integration/auto_jobs/esw_github_doxy/git/master/embeddedsw/lib/sw_services/xilpm_ng/src/util/xpm_alloc.h" line="24" column="1" bodyfile="/proj/xhdsswstaff1/bhawanas/patch_integration/auto_jobs/esw_github_doxy/git/master/embeddedsw/lib/sw_services/xilpm_ng/src/util/xpm_alloc.c" bodystart="49" bodyend="75"/>
      </memberdef>
      <memberdef kind="function" id="xpm__alloc_8h_1a39d974540fd47f16206d23cd9055375c" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>void</type>
        <definition>void XPm_DumpMemUsage_Pool</definition>
        <argsstring>(XPm_AllocablePool_t PoolMem)</argsstring>
        <name>XPm_DumpMemUsage_Pool</name>
        <param>
          <type>XPm_AllocablePool_t</type>
          <declname>PoolMem</declname>
        </param>
        <briefdescription>
<para>Print the total, used, and free byte counts for a memory pool. </para>        </briefdescription>
        <detaileddescription>
<para>Derives the used and free counts from the pool base, size, and current free pointer without modifying the pool.</para><para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>PoolMem</parametername>
</parameternamelist>
<parameterdescription>
<para>Pool descriptor to report, passed by value.</para></parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>None. </para></simplesect>
</para>        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
