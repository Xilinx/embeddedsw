        <briefdescription>
<para>Get the wake processor ID associated with a peripheral device. </para>        </briefdescription>
        <detaileddescription>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>Device</parametername>
<parametername>:</parametername>
</parameternamelist>
<parameterdescription>
<para>Peripheral device to look up in the peripheral list </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>WakeProcId</parametername>
<parametername>:</parametername>
</parameternamelist>
<parameterdescription>
