      <memberdef kind="function" id="xpm__runtime__periph_8c_1a9757cf977bd8f2ee2adb2278612449a3" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>XStatus</type>
        <definition>XStatus XPmRuntime_Periph_SetWakeProcId</definition>
        <argsstring>(XPm_Periph *Device, u32 WakeProcId)</argsstring>
        <name>XPmRuntime_Periph_SetWakeProcId</name>
        <param>
          <type>XPm_Periph *</type>
          <declname>Device</declname>
        </param>
        <param>
          <type>u32</type>
          <declname>WakeProcId</declname>
        </param>
        <briefdescription>
<para>Associate a wake processor ID with a peripheral device. </para>        </briefdescription>
        <detaileddescription>
<para>Set the wake processor ID associated with a peripheral device.</para><para>Updates an existing association when one is present. Otherwise, lazily creates the peripheral list, allocates a new association, and prepends it to the list. Allocated list storage persists for the firmware lifetime.</para><para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>Device</parametername>
</parameternamelist>
<parameterdescription>
<para>Peripheral device to associate with <computeroutput>WakeProcId</computeroutput>. </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>WakeProcId</parametername>
</parameternamelist>
<parameterdescription>
<para>Wake processor node ID to store.</para></parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>XST_SUCCESS when the association is stored; XST_INVALID_PARAM when <computeroutput>Device</computeroutput> is NULL; XST_BUFFER_TOO_SMALL when list or entry allocation fails. </para></simplesect>
</para>        </detaileddescription>
