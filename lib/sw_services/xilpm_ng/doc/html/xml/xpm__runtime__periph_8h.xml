        <briefdescription>
<para>Get the wake processor ID associated with a peripheral device. </para>        </briefdescription>
        <detaileddescription>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>Device</parametername>
<parametername>:</parametername>
</parameternamelist>
<parameterdescription>
<para>Peripheral device to look up in the peripheral list </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>WakeProcId</parametername>
<parametername>:</parametername>
</parameternamelist>
<parameterdescription>
<para>Pointer that receives the wake processor ID</para></parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>XST_SUCCESS if found, XST_INVALID_PARAM for NULL arguments, XST_DEVICE_NOT_FOUND if the peripheral list is empty</para></simplesect>
<parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>Device</parametername>
<parametername>:</parametername>
</parameternamelist>
<parameterdescription>
<para>Peripheral device to look up in the peripheral list </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>WakeProcId</parametername>
<parametername>:</parametername>
</parameternamelist>
<parameterdescription>
<para>Pointer that receives the wake processor ID on success; unchanged when no association is found</para></parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>XST_SUCCESS if found; XST_INVALID_PARAM for NULL arguments; XST_DEVICE_NOT_FOUND if the peripheral list is empty; XST_FAILURE if the list contains no association for <computeroutput>Device</computeroutput>. </para></simplesect>
</para>        </detaileddescription>
