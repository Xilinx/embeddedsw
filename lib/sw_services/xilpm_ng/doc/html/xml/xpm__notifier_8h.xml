      <memberdef kind="function" id="xpm__notifier_8h_1a02467ad75537523a0115cc407aa4fd4f" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>XStatus</type>
        <definition>XStatus XPmNotifier_IsRegistered</definition>
        <argsstring>(u32 SubsystemId, u32 NodeId, u32 Mask)</argsstring>
        <name>XPmNotifier_IsRegistered</name>
        <param>
          <type>u32</type>
          <declname>SubsystemId</declname>
        </param>
        <param>
          <type>u32</type>
          <declname>NodeId</declname>
        </param>
        <param>
          <type>u32</type>
          <declname>Mask</declname>
        </param>
        <briefdescription>
<para>Check whether the caller has registered notifiers covering EVERY requested event-mask bit for the given subsystem and node. </para>        </briefdescription>
        <detaileddescription>
<para>Used by GET_EVENT_STATUS_REGS as the permission gate: the requested Mask must be a subset of the bits registered by the caller for {NodeId}, otherwise a caller registered for one bit could read/clear another bit via an OR&apos;d mask.</para><para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>SubsystemId</parametername>
</parameternamelist>
<parameterdescription>
<para>Subsystem Id of the caller </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>NodeId</parametername>
</parameternamelist>
<parameterdescription>
<para>Event/error node id (e.g. PMC_ERR1) </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>Mask</parametername>
</parameternamelist>
<parameterdescription>
<para>Requested event mask (all bits must be registered)</para></parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>XST_SUCCESS if every requested bit is registered; XPM_PM_NO_ACCESS otherwise. </para></simplesect>
</para>        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
