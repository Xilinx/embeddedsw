        <type>XStatus</type>
        <definition>XStatus XPm_FeatureCheck</definition>
        <argsstring>(u32 ApiId, u32 *Version)</argsstring>
        <name>XPm_FeatureCheck</name>
        <param>
          <type>u32</type>
          <declname>ApiId</declname>
        </param>
        <param>
          <type>u32 *</type>
          <declname>Version</declname>
        </param>
        <briefdescription>
<para>This function returns supported version of the given API. </para>        </briefdescription>
        <detaileddescription>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>ApiId</parametername>
</parameternamelist>
<parameterdescription>
<para>API ID to check </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>Version</parametername>
</parameternamelist>
<parameterdescription>
<para>pointer to array of 4 words<itemizedlist>
<listitem><para>version[0] - EEMI API version number</para></listitem><listitem><para>version[1] - lower 32-bit bitmask of IOCTL or QUERY ID</para></listitem><listitem><para>version[2] - upper 32-bit bitmask of IOCTL or Query ID</para></listitem><listitem><para>Only PM_FEATURE_CHECK version 2 supports 64-bit bitmask</para></listitem><listitem><para>i.e. version[1] and version[2] </para></listitem></itemizedlist>
</para></parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>XST_SUCCESS if successful else XST_NO_FEATURE.</para></simplesect>
<simplesect kind="note"><para>Remove CDO-only commands from versioning as it is for internal use only, so no need to consider for versioning. </para></simplesect>
</para>        </detaileddescription>
