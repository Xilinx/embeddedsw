      <memberdef kind="function" id="xpm__runtime__alloc_8h_1a80989390a7a9e58b33813943504f7a6f" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>void *</type>
        <definition>void* XPm_AllocBytesSubsys</definition>
        <argsstring>(u32 SizeInBytes)</argsstring>
        <name>XPm_AllocBytesSubsys</name>
        <param>
          <type>u32</type>
          <declname>SizeInBytes</declname>
        </param>
        <briefdescription>
<para>Allocate zero-initialized storage from the subsystem pool. </para>        </briefdescription>
        <detaileddescription>
<para>Advances the subsystem pool through XPm_AllocPool(). On failure, logs the requested size and dumps usage information for all runtime memory pools.</para><para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>SizeInBytes</parametername>
</parameternamelist>
<parameterdescription>
<para>Number of bytes requested.</para></parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>Pointer to the allocated region on success; NULL on failure. </para></simplesect>
</para>        </detaileddescription>
