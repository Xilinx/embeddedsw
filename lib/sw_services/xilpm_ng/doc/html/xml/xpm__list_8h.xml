      <memberdef kind="define" id="xpm__list_8h_1adf32351e56236ed8da6168e7aa0c37c8" prot="public" static="no">
        <name>CREATE_LIST</name>
        <param><defname>T</defname></param>
        <initializer>/* Creates a node type of T - named &quot;{T}Node&quot; */ \
typedef struct T##Node { \
	T* Data; \
	struct T##Node *Next; \
} T##Node; \
\
/* Creates a list type of &quot;{T}Node&quot; */ \
typedef struct T##List { \
	T##Node *Root; \
} T##List; \
\
/* Creates a function to make a new list of type &quot;{T}List&quot;, named &quot;Make_{T}List&quot; */ \
static inline T##List* Make_##T##List(void) { \
	T##List* list = (T##List *)XPm_AllocBytesOthers(sizeof(T##List)); \
	if (list != NULL) { \
		list-&gt;Root = NULL; \
	} \
	return list; \
}</initializer>
