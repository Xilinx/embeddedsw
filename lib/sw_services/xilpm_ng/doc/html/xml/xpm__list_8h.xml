      <memberdef kind="define" id="xpm__list_8h_1a441d3e44cef6a800ae4206164d8a726d" prot="public" static="no">
        <name>LIST_PREPEND</name>
        <param><defname>List</defname></param>
        <param><defname>Value</defname></param>
        <initializer>do { \
	typeof((List)-&gt;Root) NewNode = (typeof((List)-&gt;Root))XPm_AllocBytesOthers(sizeof(*(List)-&gt;Root)); \
	if (NULL == NewNode) { \
		PmErr(&quot;OOM: Data container to be added to %s\r\n&quot;, #List); \
		Status = XST_BUFFER_TOO_SMALL; \
		goto done; \
	} \
	NewNode-&gt;Data = (Value); \
	NewNode-&gt;Next = (List)-&gt;Root; \
	(List)-&gt;Root = NewNode; \
} while (0)</initializer>
