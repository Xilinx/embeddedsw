      <memberdef kind="function" id="xpm__alloc_8c_1a3ba40d3dabe1c8aca09e36c62d8ef412" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>void *</type>
        <definition>void* XPm_AllocPool</definition>
        <argsstring>(u32 SizeInBytes, XPm_AllocablePool_t *PoolMem)</argsstring>
        <name>XPm_AllocPool</name>
        <param>
          <type>u32</type>
          <declname>SizeInBytes</declname>
        </param>
        <param>
          <type>XPm_AllocablePool_t *</type>
          <declname>PoolMem</declname>
        </param>
        <briefdescription>
<para>Allocate zero-initialized storage from a monotonic memory pool. </para>        </briefdescription>
        <detaileddescription>
<para>Rounds <computeroutput>SizeInBytes</computeroutput> up to a four-byte boundary, advances the pool&apos;s free pointer by the rounded size, and securely zeroes the allocated region. The pool has no corresponding free operation, and a zeroization failure does not roll back the free pointer.</para><para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>SizeInBytes</parametername>
</parameternamelist>
<parameterdescription>
<para>Number of bytes requested. </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>PoolMem</parametername>
</parameternamelist>
<parameterdescription>
<para>Pool descriptor whose free pointer is advanced on success.</para></parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>Pointer to the allocated region if allocation reaches the zeroization step, including when secure zeroization fails (in which case the returned memory may not be zeroed); NULL if the pool has no bytes left or the rounded request exceeds the available space. </para></simplesect>
</para>        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
