        <name>XPmRpuCore_ReleaseReset</name>
        <param>
          <type>u32</type>
          <declname>CoreId</declname>
        </param>
        <briefdescription>
<para>Release all reset controls attached to an RPU core. </para>        </briefdescription>
        <detaileddescription>
<para><verbatim>    Retrieves and validates the RPU core, then clears every reset field
    linked through its reset handles.
</verbatim></para><para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>CoreId</parametername>
</parameternamelist>
<parameterdescription>
<para>Device ID of the RPU core to release from reset.</para></parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>XST_SUCCESS when all reset fields are cleared; XST_INVALID_PARAM when a registered node is not an RPU core; or XST_FAILURE when the core or one of its reset nodes is absent. </para></simplesect>
</para>        </detaileddescription>
