      <memberdef kind="function" id="xpm__rpucore_8h_1a83247b6dec2a14a03f8f6235bf1c32ff" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>XStatus</type>
        <definition>XStatus XPmRpuCore_ResetAndHalt</definition>
        <argsstring>(u32 CoreId)</argsstring>
        <name>XPmRpuCore_ResetAndHalt</name>
        <param>
          <type>u32</type>
          <declname>CoreId</declname>
        </param>
        <briefdescription>
<para>Assert all resets for an RPU core and place the core in halt state. </para>        </briefdescription>
        <detaileddescription>
<para><verbatim>    Retrieves and validates the RPU core, sets every reset field linked
    through its reset handles, and writes the core&apos;s resume
    configuration to halt execution.
</verbatim></para><para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>CoreId</parametername>
</parameternamelist>
<parameterdescription>
<para>Device ID of the RPU core to reset and halt.</para></parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>XST_SUCCESS when all reset fields are asserted and the core is halted; XST_INVALID_PARAM when a registered node is not an RPU core; or XST_FAILURE when the core or one of its reset nodes is absent. </para></simplesect>
</para>        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
