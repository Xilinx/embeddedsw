        <type>XStatus</type>
        <definition>XStatus XPmMem_TcmResetRelease</definition>
        <argsstring>(const XPm_Device *Device)</argsstring>
        <name>XPmMem_TcmResetRelease</name>
        <param>
          <type>const <ref refid="struct_x_pm___device_node" kindref="compound">XPm_Device</ref> *</type>
          <declname>Device</declname>
        </param>
        <briefdescription>
<para>Release the associated RPU reset and initialize TCM ECC. </para>        </briefdescription>
        <detaileddescription>
<para>The owning RPU is reset and halted, its reset is released, and the complete TCM address range is passed to the ECC initialization routine.</para><para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>Device</parametername>
</parameternamelist>
<parameterdescription>
<para>Pointer to the TCM memory device</para></parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>XST_SUCCESS on success, XST_INVALID_PARAM for a NULL device or an unknown TCM ID, or an error from the RPU reset or ECC initialization operation </para></simplesect>
</para>        </detaileddescription>
