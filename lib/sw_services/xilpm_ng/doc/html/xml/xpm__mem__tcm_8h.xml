        <type>XStatus</type>
        <definition>XStatus XPm_GetRpuByTcmId</definition>
        <argsstring>(u32 TcmId, u32 *RpuId)</argsstring>
        <name>XPm_GetRpuByTcmId</name>
        <param>
          <type>u32</type>
          <declname>TcmId</declname>
        </param>
        <param>
          <type>u32 *</type>
          <declname>RpuId</declname>
        </param>
        <briefdescription>
<para>Map a TCM device node ID to its owning RPU core node ID. </para>        </briefdescription>
        <detaileddescription>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>TcmId</parametername>
</parameternamelist>
<parameterdescription>
<para>TCM device node ID </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>RpuId</parametername>
</parameternamelist>
<parameterdescription>
<para>Non-NULL pointer to receive the owning RPU core node ID</para></parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>XST_SUCCESS for a recognized TCM ID, or XST_INVALID_PARAM when TcmId is not recognized </para></simplesect>
</para>        </detaileddescription>
