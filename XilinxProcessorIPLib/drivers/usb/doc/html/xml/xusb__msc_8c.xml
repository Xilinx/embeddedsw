      <memberdef kind="function" id="xusb__msc_8c_1ac92528d9ca5362f261319f90c279935f" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>void</type>
        <definition>void XUsb_MsRejectCommand</definition>
        <argsstring>(XUsb *InstancePtr, u8 EndPoint, u32 TransferLength, u8 *CswStatus, u32 *CswResidue, volatile u32 *BlockCount, volatile u8 *CmdFlag, volatile u8 *SendStatus)</argsstring>
        <name>XUsb_MsRejectCommand</name>
        <param>
          <type><ref refid="struct_x_usb" kindref="compound">XUsb</ref> *</type>
          <declname>InstancePtr</declname>
        </param>
        <param>
          <type>u8</type>
          <declname>EndPoint</declname>
        </param>
        <param>
          <type>u32</type>
          <declname>TransferLength</declname>
        </param>
        <param>
          <type>u8 *</type>
          <declname>CswStatus</declname>
        </param>
        <param>
          <type>u32 *</type>
          <declname>CswResidue</declname>
        </param>
        <param>
          <type>volatile u32 *</type>
          <declname>BlockCount</declname>
        </param>
        <param>
          <type>volatile u8 *</type>
          <declname>CmdFlag</declname>
        </param>
        <param>
          <type>volatile u8 *</type>
          <declname>SendStatus</declname>
        </param>
        <briefdescription>
<para>This function rejects a mass storage command that cannot be serviced. </para>        </briefdescription>
        <detaileddescription>
<para>The command fails with the whole requested data length as residue and the data phase endpoint is halted: bulk IN for READ, bulk OUT for WRITE. The status is then queued on bulk IN by the caller, where the core holds it until the host clears the halt when bulk IN is the stalled endpoint.</para><para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername direction="in">InstancePtr</parametername>
</parameternamelist>
<parameterdescription>
<para>is a pointer to the <ref refid="struct_x_usb" kindref="compound">XUsb</ref> instance. </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">EndPoint</parametername>
</parameternamelist>
<parameterdescription>
<para>is the endpoint carrying the data phase. </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">TransferLength</parametername>
</parameternamelist>
<parameterdescription>
<para>is the data transfer length from the Command Block Wrapper. </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="out">CswStatus</parametername>
</parameternamelist>
<parameterdescription>
<para>is a pointer to the status field of the Command Status Wrapper. </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="out">CswResidue</parametername>
</parameternamelist>
<parameterdescription>
<para>is a pointer to the data residue field of the Command Status Wrapper. </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="out">BlockCount</parametername>
</parameternamelist>
<parameterdescription>
<para>is a pointer to the pending transfer block count. It is cleared when non-NULL. </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="out">CmdFlag</parametername>
</parameternamelist>
<parameterdescription>
<para>is a pointer to the command-in-progress flag. It is cleared when non-NULL. </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="out">SendStatus</parametername>
</parameternamelist>
<parameterdescription>
<para>is a pointer to the flag that requests the status phase. It is set when non-NULL.</para></parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>None.</para></simplesect>
<simplesect kind="note"><para>Pass NULL for SendStatus when the example does not keep that flag. The caller queues the CSW and records it only after that send succeeds. </para></simplesect>
</para>        </detaileddescription>
