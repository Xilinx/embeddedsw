      <sectiondef kind="func">
      <memberdef kind="function" id="group__bram_1gab2056c1f9272b35a37e7f20ac2fd0af9" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type><ref refid="struct_x_bram___config" kindref="compound">XBram_Config</ref> *</type>
        <definition>XBram_Config* XBram_LookupConfig</definition>
        <argsstring>(UINTPTR BaseAddress)</argsstring>
        <name>XBram_LookupConfig</name>
        <param>
          <type>UINTPTR</type>
          <declname>BaseAddress</declname>
        </param>
        <briefdescription>
<para>Looks up the device configuration for a BRAM instance. </para>        </briefdescription>
        <detaileddescription>
<para>Uses XBram_ConfigTable[] which contains the configuration info for each device in the system.</para><para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername direction="in">BaseAddress</parametername>
</parameternamelist>
<parameterdescription>
<para>Contains the base address of the device.</para></parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>A pointer to the configuration found, or NULL if the specified device ID or base address was not found. See <ref refid="xbram_8h" kindref="compound">xbram.h</ref> for the definition of <ref refid="struct_x_bram___config" kindref="compound">XBram_Config</ref>.</para></simplesect>
<simplesect kind="note"><para>In XSCT/classic flow, DeviceId is used to look up the device configuration. </para></simplesect>
</para>        </detaileddescription>
