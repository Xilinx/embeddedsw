      <memberdef kind="function" id="group__mutex_1ga1255fbeea64f519d8def63e542ce8703" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>void</type>
        <definition>void XMutex_Lock</definition>
        <argsstring>(XMutex *InstancePtr, u8 MutexNumber)</argsstring>
        <name>XMutex_Lock</name>
        <param>
          <type><ref refid="struct_x_mutex" kindref="compound">XMutex</ref> *</type>
          <declname>InstancePtr</declname>
        </param>
        <param>
          <type>u8</type>
          <declname>MutexNumber</declname>
        </param>
        <briefdescription>
<para>Locks a Mutex within a Mutex device. </para>        </briefdescription>
        <detaileddescription>
<para>Locks a particular Mutex lock within a Mutex device. Call blocks till the Mutex is locked.</para><para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername direction="in">InstancePtr</parametername>
</parameternamelist>
<parameterdescription>
<para>Pointer to the <ref refid="struct_x_mutex" kindref="compound">XMutex</ref> instance to be worked on. </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">MutexNumber</parametername>
</parameternamelist>
<parameterdescription>
<para>Specific Mutex lock within the device to operate on. Each device may contain multiple Mutex locks. The Mutex number is a zero based number with a range of 0 - (InstancePtr-&gt;Config.NumMutex - 1).</para></parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="note"><para><itemizedlist>
<listitem><para>XMutex_Lock blocks until the caller gets the lock.</para></listitem><listitem><para>Use XMutex_Trylock for a non-blocking call. The caller gets the lock if it is available and returns immediately if the lock is not available. </para></listitem></itemizedlist>
</para></simplesect>
</para>        </detaileddescription>
