OPTION psf_version = 2.1;

BEGIN driver mbox
  OPTION supported_peripherals = (xps_mailbox mailbox);
  OPTION driver_state = ACTIVE;
  OPTION copyfiles = all;
  OPTION VERSION = 4.11;
  OPTION NAME = mbox;

END driver
