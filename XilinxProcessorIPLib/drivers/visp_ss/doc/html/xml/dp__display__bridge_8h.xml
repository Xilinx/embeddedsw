        <type>int</type>
        <definition>int DpDisplayBridge_Init</definition>
        <argsstring>(u32 Width, u32 Height, XVidC_ColorFormat MemCfmt, u32 Stride, u32 ChromaOffset)</argsstring>
        <name>DpDisplayBridge_Init</name>
        <param>
          <type>u32</type>
          <declname>Width</declname>
        </param>
        <param>
          <type>u32</type>
          <declname>Height</declname>
        </param>
        <param>
          <type>XVidC_ColorFormat</type>
          <declname>MemCfmt</declname>
        </param>
        <param>
          <type>u32</type>
