      <memberdef kind="function" id="group__can_1gaf60120410396727f6e9304ce9ba65980" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>int</type>
        <definition>int XCan_SetBitTiming</definition>
        <argsstring>(XCan *InstancePtr, u8 SyncJumpWidth, u8 TimeSegment2, u8 TimeSegment1)</argsstring>
        <name>XCan_SetBitTiming</name>
        <param>
          <type><ref refid="struct_x_can" kindref="compound">XCan</ref> *</type>
          <declname>InstancePtr</declname>
        </param>
        <param>
          <type>u8</type>
          <declname>SyncJumpWidth</declname>
        </param>
        <param>
          <type>u8</type>
          <declname>TimeSegment2</declname>
        </param>
        <param>
          <type>u8</type>
          <declname>TimeSegment1</declname>
        </param>
        <briefdescription>
<para>Sets the Bit Timing Register values. </para>        </briefdescription>
        <detaileddescription>
<para>Time segment 1, Time segment 2 and Synchronization Jump Width are set in this function. Device specification requires the values passed into this function be one less than the actual values of these fields. Read the device specification for details.</para><para>Set the Bit time only after the CAN device enters Configuration Mode. Call <ref refid="group__can_1ga994a0b0bd9c938e99de9d7ffceb10ef3" kindref="member">XCan_EnterMode()</ref> to enter Configuration Mode before using this function.</para><para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername direction="in">InstancePtr</parametername>
</parameternamelist>
<parameterdescription>
<para>Pointer to the <ref refid="struct_x_can" kindref="compound">XCan</ref> instance to be worked on. </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">SyncJumpWidth</parametername>
</parameternamelist>
<parameterdescription>
<para>Synchronization Jump Width value to set. Valid values are from 0 to 3. </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">TimeSegment2</parametername>
</parameternamelist>
<parameterdescription>
<para>Time Segment 2 value to set. Valid values are from 0 to 7. </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">TimeSegment1</parametername>
</parameternamelist>
<parameterdescription>
<para>Time Segment 1 value to set. Valid values are from 0 to 15.</para></parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para><itemizedlist>
<listitem><para>XST_SUCCESS if the Bit time is set successfully.</para></listitem><listitem><para>XST_FAILURE if CAN device is not in Configuration Mode.<itemizedlist>
<listitem><para>XST_INVALID_PARAM if any value of SyncJumpWidth, TimeSegment2 and TimeSegment1 is invalid. </para></listitem></itemizedlist>
</para></listitem></itemizedlist>
</para></simplesect>
</para>        </detaileddescription>
