        <argsstring>(XHdmiphy1 *InstancePtr, u8 QuadId, XHdmiphy1_DirectionType Dir)</argsstring>
        <name>XHdmiphy1_DpllWriteParameters</name>
        <param>
          <type><ref refid="struct_x_hdmiphy1" kindref="compound">XHdmiphy1</ref> *</type>
          <declname>InstancePtr</declname>
