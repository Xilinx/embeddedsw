        <type>s32</type>
        <definition>s32 AmdXspi_SetClkMode</definition>
        <argsstring>(AmdXspi *InstancePtr, u8 ClkMode)</argsstring>
        <name>AmdXspi_SetClkMode</name>
        <param>
          <type><ref refid="struct_amd_xspi" kindref="compound">AmdXspi</ref> *</type>
          <declname>InstancePtr</declname>
        </param>
        <param>
          <type>u8</type>
          <declname>ClkMode</declname>
        </param>
        <briefdescription>
<para>Sets the SPI clock mode (CPOL/CPHA). </para>        </briefdescription>
        <detaileddescription>
<para>The clock is only programmable in the Standard, Dual and Quad modes. A core built for one of the xSPI profiles runs mode 0 and nothing else, so that is the only value it accepts.</para><para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername direction="in">InstancePtr</parametername>
</parameternamelist>
<parameterdescription>
<para>Pointer to the <ref refid="struct_amd_xspi" kindref="compound">AmdXspi</ref> instance. </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">ClkMode</parametername>
</parameternamelist>
<parameterdescription>
<para>Clock mode (0-3):<itemizedlist>
<listitem><para>0: CPOL=0, CPHA=0</para></listitem><listitem><para>1: CPOL=0, CPHA=1</para></listitem><listitem><para>2: CPOL=1, CPHA=0</para></listitem><listitem><para>3: CPOL=1, CPHA=1.</para></listitem></itemizedlist>
</para></parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>- XST_SUCCESS if successful.<itemizedlist>
<listitem><para>XST_INVALID_PARAM if the mode is out of range, or is not mode 0 on a core built for an xSPI profile. </para></listitem></itemizedlist>
</para></simplesect>
</para>        </detaileddescription>
