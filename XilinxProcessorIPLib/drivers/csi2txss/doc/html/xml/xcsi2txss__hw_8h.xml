      <memberdef kind="function" id="group__csi2txss_1gad02a74fc64d39691117b3f2310788e4f" prot="public" static="yes" const="no" explicit="no" inline="yes" virt="non-virtual">
        <type>void</type>
        <definition>static void XCsi2TxSs_WriteReg</definition>
        <argsstring>(UINTPTR BaseAddress, u32 RegOffset, u32 Data)</argsstring>
        <name>XCsi2TxSs_WriteReg</name>
        <param>
          <type>UINTPTR</type>
          <declname>BaseAddress</declname>
        </param>
        <param>
          <type>u32</type>
          <declname>RegOffset</declname>
        </param>
        <param>
          <type>u32</type>
          <declname>Data</declname>
        </param>
        <briefdescription>
<para>This function writes a value to a MIPI CSI2 Tx Subsystem register. </para>        </briefdescription>
        <detaileddescription>
<para>A 32 bit write is performed. If the component is implemented in a smaller width, only the least significant data is written.</para><para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>BaseAddress</parametername>
</parameternamelist>
<parameterdescription>
<para>is the base address of the XCsi2Tx core instance. </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>RegOffset</parametername>
</parameternamelist>
<parameterdescription>
<para>is the register offset of the register (defined at the top of this file) to be written. </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>Data</parametername>
</parameternamelist>
<parameterdescription>
<para>is the 32-bit value to write into the register.</para></parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>None.</para></simplesect>
<simplesect kind="note"><para>None. </para></simplesect>
</para>        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
