      <memberdef kind="function" id="group__xspips__eeprom__polled__example_1ga2f23357b0cfe111d80824b3bfacb8b22" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>void</type>
        <definition>void EepromWrite</definition>
        <argsstring>(XSpiPs *SpiPtr, u16 Address, u8 ByteCount, EepromBuffer Buffer)</argsstring>
        <name>EepromWrite</name>
        <param>
          <type><ref refid="struct_x_spi_ps" kindref="compound">XSpiPs</ref> *</type>
          <declname>SpiPtr</declname>
        </param>
        <param>
          <type>u16</type>
